<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>GalaxyBridge</AssemblyName>
    <Version>0.6.1</Version>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../GalaxyBridge.Core/GalaxyBridge.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Keep QRCoder's drawing dependency on the application's .NET 8 line. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.30" />
  </ItemGroup>
</Project>
