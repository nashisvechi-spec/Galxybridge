<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.56</WindowsSdkPackageVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/App.ico</ApplicationIcon>
    <AssemblyName>GalaxyBridge</AssemblyName>
    <Version>0.7.4</Version>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Resources/App.ico" LogicalName="GalaxyBridge.App.ico" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../GalaxyBridge.Core/GalaxyBridge.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Keep QRCoder's drawing dependency on the application's .NET 8 line. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.30" />
  </ItemGroup>
</Project>
