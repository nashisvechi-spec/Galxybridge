<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.galaxybridge.files">
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="com.galaxybridge.lan.permission.FILES_BRIDGE" />
    <queries><package android:name="com.galaxybridge.lan" /></queries>
    <application android:label="Galaxy Files" android:icon="@drawable/ic_files"
        android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".FilesActivity" android:exported="true" android:resizeableActivity="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <provider android:name=".SharedFilesProvider" android:authorities="com.galaxybridge.files.shared"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
